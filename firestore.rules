rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isAdmin() { return signedIn() && ownProfile().data.role == 'admin'; }
    function canEdit() { return signedIn() && ownProfile().data.role in ['admin', 'member']; }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId
                    && request.resource.data.role == 'reader';
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role)
                    || (signedIn() && request.auth.uid == userId
                    && !exists(/databases/$(database)/documents/config/bootstrap)
                    && existsAfter(/databases/$(database)/documents/config/bootstrap)
                    && getAfter(/databases/$(database)/documents/config/bootstrap).data.uid == request.auth.uid
                    && request.resource.data.role == 'admin');
      allow delete: if isAdmin() && request.auth.uid != userId;
    }
    match /dossiers/{id} {
      allow read: if signedIn();
      allow create, update: if canEdit();
      allow delete: if isAdmin();
    }
    match /comments/{id} {
      allow read, create: if signedIn();
      allow update, delete: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
    }
    match /attachments/{id} {
      allow read: if signedIn();
      allow create: if canEdit();
      allow update, delete: if isAdmin() || (signedIn() && resource.data.addedBy == request.auth.uid);
    }
    match /history/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
    match /config/bootstrap {
      allow read: if signedIn();
      allow create: if signedIn()
                    && !exists(/databases/$(database)/documents/config/bootstrap)
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /config/{id} {
      allow read: if signedIn();
      allow write: if isAdmin() && id != 'bootstrap';
    }
  }
}
